#!/bin/bash
#PBS -N vocal-env
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l jobfs=10GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/wa66+gdata/wa66
#PBS -j oe
set -euo pipefail
ROOT=/scratch/wa66/hm6416/vocal-musdb-20261012
BASE=/scratch/wa66/hm6416/envs/muse-grpo-cu128
module load python3/3.11.7
module load gcc/12.2.0
HEADER=$(python3 -c 'import sysconfig; print(sysconfig.get_path("include"))')
export C_INCLUDE_PATH="$HEADER" CPLUS_INCLUDE_PATH="$HEADER" MAX_JOBS=1
"$BASE/bin/python" -m venv "$ROOT/env"
BASE_SITE=$("$BASE/bin/python" -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
export BASE_SITE
"$ROOT/env/bin/python" - <<'PY'
import os, pathlib, sysconfig
site = pathlib.Path(sysconfig.get_path('purelib'))
(site / 'shared-torch.pth').write_text(os.environ['BASE_SITE'] + '\n')
PY
"$ROOT/env/bin/python" -m pip install --upgrade pip 'setuptools>=77,<81' wheel Cython
"$ROOT/env/bin/python" -m pip install \
  omegaconf==2.3.0 hydra-core==1.3.2 \
  antlr4-python3-runtime==4.9.3 lightning==2.6.5 pytorch-lightning==2.6.1 \
  torchmetrics==1.9.0 lightning-utilities librosa==0.10.2.post1 \
  audioread==3.1.0 julius==0.2.7 encodec==0.1.1 nnAudio==0.3.4 \
  diffusers==0.38.0 einx==0.4.3 vector-quantize-pytorch==1.29.1 \
  rotary-embedding-torch==0.8.9 gateloop-transformer==0.2.5 \
  x-clip==0.14.4 beartype==0.22.9 lion-pytorch==0.2.4 \
  scikit-learn==1.8.0 kaldiio==2.18.1 prodict==0.8.22 Unidecode==1.4.0 \
  av==16.0.1 lazy-loader decorator pooch sacrebleu bitarray pyworld \
  resampy einops==0.8.1
"$ROOT/env/bin/python" -m pip install --no-deps --no-build-isolation fairseq-fixed==0.12.3.1
export LADA_PRETRAINED_ROOT=/scratch/wa66/hm6416/LaDA-Band-assets/pretrained
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PYTHONPATH=/scratch/wa66/hm6416/LaDA-Band-posttrain/codes
"$ROOT/env/bin/python" -c 'import torch, fairseq, librosa; from lada_band.module.llada import ModelModule; print("IMPORT_OK", torch.__version__)'
"$ROOT/env/bin/python" -m pip freeze > "$ROOT/env-freeze.txt"
touch "$ROOT/env.complete"
python3 -m venv "$ROOT/beat-env"
"$ROOT/beat-env/bin/python" -m pip install numpy==1.26.4 scipy==1.13.1 \
  librosa==0.10.2.post1 soundfile==0.13.1 Cython==0.29.37 mido wheel 'setuptools<81'
bash "$ROOT/code/rl/grpo/setup_beat_env.pbs"
bash "$ROOT/code/rl/grpo/reward_worker_smoke.pbs"
