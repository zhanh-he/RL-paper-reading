#!/usr/bin/env bash
#PBS -P wa66
#PBS -q gpuhopper
#PBS -l ncpus=24
#PBS -l ngpus=2
#PBS -l mem=160GB
#PBS -l jobfs=60GB
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/wa66+scratch/wa66
#PBS -l wd
#PBS -N muse-cmi-9to1
set -euo pipefail

: "${REWARD:?Set REWARD to songeval or musecritic}"
: "${LR:?Set LR to a Muse learning rate}"
: "${MODE:?Set MODE to smoke or train}"
case "$REWARD" in songeval|musecritic) ;; *) exit 2 ;; esac
case "$LR" in 1e-6|3e-6|1e-5) ;; *) exit 2 ;; esac
case "$MODE" in smoke|train) ;; *) exit 2 ;; esac

module purge
module load python3/3.11.7
module load cuda/12.8.0
export PYTHONNOUSERSITE=1
unset PYTHONHOME
root=/g/data/wa66/hanyu/vocal2accomp-muse
study="$root/experiments/cmi_triple_9to1_20261006"
train_py=/scratch/wa66/hm6416/envs/muse-grpo-cu128/bin/python
codec_py="$root/envs/mucodec-py310-cu128/bin/python"
plugin="$study/muse_cmi_rewards.py"
data="$study/data/muse-cmi-triple-train.jsonl"
run="$study/outputs/${REWARD}_lr${LR}_${MODE}${RUN_TAG:+_$RUN_TAG}"
mkdir -p "$run" "$PBS_JOBFS/tmp" "$PBS_JOBFS/cache"
export TMPDIR="$PBS_JOBFS/tmp"
export XDG_CACHE_HOME="$PBS_JOBFS/cache/xdg"
export HF_HOME=/g/data/wa66/hanyu/hf-cache
export HF_HUB_OFFLINE=1
export TORCH_HOME="$PBS_JOBFS/cache/torch"
export TRITON_CACHE_DIR="$PBS_JOBFS/cache/triton"
mkdir -p "$XDG_CACHE_HOME" "$HF_HOME" "$TORCH_HOME" "$TRITON_CACHE_DIR"
export CUDA_VISIBLE_DEVICES=0
export NPROC_PER_NODE=1
export MODEL="$root/models/Muse-0.6b"
export MUSE_BASE_PLUGIN="$root/src/MuseCritic/muse_grpo/plugin.py"
export MUSE_MUCODEC_API_BASE=http://127.0.0.1:18003
export MUSE_CRITIC_API_BASE=http://127.0.0.1:18002/v1
export MUSECRITIC_RM_AUDIO_DIR="$run/decoded"
export MUSE_ROLLOUT_RESULT_PATH="$run/rollouts.jsonl"
export MUSE_GRPO_MAX_TOTAL_TOKENS=2048
export MUSE_DECODE_DURATION=10.24
export MUSE_DECODE_STEPS=20
export MUSE_CRITIC_MAX_NEW_TOKENS=512
export MUSE_MUCODEC_MAX_WORKERS=1
export MUSE_CRITIC_MAX_WORKERS=1
export MUSECRITIC_RM_STRICT=true
export MUSE_SERVICE_GPU=1
export SONGEVAL_REPO=/g/data/wa66/hanyu/SongEval-formal
export SONGEVAL_PY=/g/data/wa66/hanyu/YuE2-posttrain/.venv/bin/python
export MUSE_SCORING_DIR="$run/songeval_scoring"

"$train_py" - "$run/experiment.json" "$REWARD" "$LR" "$MODE" "$data" <<'PY'
import hashlib, json, pathlib, sys
path = pathlib.Path(sys.argv[1])
reward, lr, mode = sys.argv[2:5]
dataset = pathlib.Path(sys.argv[5])
actual = hashlib.sha256(dataset.read_bytes()).hexdigest()
assert actual == 'ff437d751d62742d92daf7ac56a678010c52d6c22def5624a8324301e6699be6'
manifest = {'source_split_sha256': '2f5f31219514ad479984e921a8dc6603680e275f31531778c7bb018da5df0136',
            'projected_manifest_sha256': 'c39d43e81793bee3f312c7028a0483b5da41068db4544acd258115043101e46f',
            'muse_train_jsonl_sha256': actual, 'train_conditions': 270, 'valid_conditions': 30,
            'input_modalities': ['text', 'lyrics'], 'reference_audio_used': False,
            'model': 'Muse-0.6b', 'reward': reward, 'learning_rate': lr, 'mode': mode,
            'planned_steps': 2 if mode == 'smoke' else 270}
if path.exists():
    assert json.loads(path.read_text()) == manifest, 'Existing run has different configuration'
else:
    path.write_text(json.dumps(manifest, indent=2) + '\n')
PY

pids=()
cleanup() { for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done; wait 2>/dev/null || true; }
trap cleanup EXIT

LD_LIBRARY_PATH="/apps/python3/3.10.4/lib:${LD_LIBRARY_PATH:-}" CUDA_VISIBLE_DEVICES=1 \
  "$codec_py" "$root/src/MuCodec/deploy/mucodec_serve.py" \
  --model "$root/src/MuCodec/weights/mucodec.pt" --host 127.0.0.1 --port 18003 \
  >"$run/mucodec.log" 2>&1 &
pids+=("$!")
ports=(18001 18003)
reward_name=songeval_rm
if [[ "$REWARD" == musecritic ]]; then
  reward_name=musecritic_pcm24_rm
  CUDA_VISIBLE_DEVICES=1 "$train_py" "$root/src/MuseCritic/muse_grpo/deploy/musecritic/musecritic_serve.py" \
    --model "$root/models/MuseCritic" --host 127.0.0.1 --port 18002 --max-new-tokens 512 \
    >"$run/musecritic.log" 2>&1 &
  pids+=("$!")
  ports+=(18002)
fi
CUDA_VISIBLE_DEVICES=1 "$(dirname "$train_py")/swift" rollout \
  --model_type qwen3 --model "$MODEL" --external_plugins "$plugin" \
  --multi_turn_scheduler muse_multi_turn_scheduler \
  --vllm_use_async_engine true --host 127.0.0.1 --port 18001 \
  --vllm_max_model_len 2048 --vllm_gpu_memory_utilization 0.15 \
  --temperature 0.9 --repetition_penalty 1.3 --top_p 0.9 \
  >"$run/rollout_server.log" 2>&1 &
pids+=("$!")

for port in "${ports[@]}"; do
  ready=false
  for _ in $(seq 1 180); do
    if curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; then ready=true; break; fi
    sleep 5
  done
  [[ "$ready" == true ]] || { echo "Service $port did not become ready" >&2; exit 1; }
done

steps=270
save_steps=30
if [[ "$MODE" == smoke ]]; then steps=2; save_steps=1; fi
"$(dirname "$train_py")/swift" rlhf \
  --rlhf_type grpo --model_type qwen3 --model "$MODEL" \
  --reward_funcs "$reward_name" --external_plugins "$plugin" \
  --tuner_type lora --lora_rank 8 --dataset "$data" \
  --use_vllm true --vllm_mode server --vllm_server_host 127.0.0.1 \
  --vllm_server_port 18001 --vllm_server_pass_dataset true --vllm_server_timeout 1200 \
  --max_completion_length 512 --max_length 2048 \
  --per_device_train_batch_size 2 --gradient_accumulation_steps 1 --num_generations 2 \
  --max_steps "$steps" --learning_rate "$LR" --beta 0.01 \
  --save_steps "$save_steps" --logging_steps 1 --temperature 0.9 \
  --repetition_penalty 1.3 --top_p 0.9 \
  --report_to none --output_dir "$run/checkpoint" \
  >"$run/train.log" 2>&1

"$train_py" - "$run" "$steps" <<'PY'
import hashlib, json, pathlib, sys
root, steps = pathlib.Path(sys.argv[1]), int(sys.argv[2])
records = [json.loads(line) for line in (root / 'rollouts.jsonl').read_text().splitlines() if line]
adapters = list((root / 'checkpoint').rglob('adapter_model.safetensors'))
bound = []
for record in records:
    for key, value in record.items():
        if not key.startswith('audio_path_') or not value:
            continue
        suffix = key.removeprefix('audio_path_')
        path = pathlib.Path(value)
        if not path.is_file():
            raise FileNotFoundError(path)
        bound.append({'audio_path': str(path.relative_to(root)),
                      'sha256': hashlib.sha256(path.read_bytes()).hexdigest(),
                      'reward': record.get(f'reward_{suffix}')})
receipt = {'status': 'training-complete' if adapters and len(bound) >= 2 * steps else 'incomplete',
           'steps_requested': steps, 'rollout_records': len(records), 'bound_audio': bound,
           'adapter_checkpoints': len(adapters), 'validation_status': 'not-yet-evaluated'}
(root / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
if receipt['status'] != 'training-complete':
    raise ValueError(f'Incomplete Muse training: {receipt}')
PY
