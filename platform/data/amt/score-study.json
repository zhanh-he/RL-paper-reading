  "experiments": [
    {
      "id": "sheet-gtzan10",
      "title": "E1 · SheetSage2 / real GTZAN",
      "data": "10 genres × one real 30s recording; Beat This! v1.0 references",
      "protocol": "Paper D.1: first 5s excluded, 70ms beat/downbeat F1; macro recording mean",
      "action": "Frozen inference; retain lead-sheet outputs; no test tuning",
      "status": "Completed 10/10 · beat 86.23%, downbeat 77.98% · 5090 BF16"
    },
    {
      "id": "duet-asap8",
      "title": "E2 · DuET / real ASAP",
      "data": "8 complete test works, ACPAS declared real split; selected before inference",
      "protocol": "Official MUSTER on complete MusicXML pairs; all 8 failures/completions retained",
      "action": "Frozen official checkpoint; full-piece score export and timing",
      "status": "Completed 8/8 · MUSTER Mean ER 4.504%"
    },
    {
      "id": "duet-duration-sft50",
      "title": "E3 · Small-data score adaptation",
      "data": "16 train works requested, confidence-filtered note matches; 4 valid; same 8 test",
      "protocol": "50 AdamW steps, lr 1e-4; duration head only; frozen baseline-context hidden states",
      "action": "Report token accuracy/CE and full-piece MUSTER separately",
      "status": "Completed 50 updates · 15 usable train works / 1651 notes; test ER 4.572% (higher is worse)"
    },
    {
      "id": "duet-duration-grpo",
      "title": "E4 · Duration-head note-action GRPO",
      "data": "Same 15 usable train works / 1651 labels, 4 valid and 8 full test works as SFT",
      "protocol": "8 sampled duration actions per note; exact forward KL to frozen head, beta .01, lr 1e-4; frozen baseline-history contexts",
      "action": "50 rollout batches / 40 optimizer updates; zero-variance groups give no policy gradient. Not full-sequence GRPO; SFT has 50 updates, so update budgets differ.",
      "status": "Completed 8/8 test · Mean ER 4.516%; duration-only did not improve complete-score error"
    }
  ],
